#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Igor Santos
# SPDX-License-Identifier: Apache-2.0
#
# bin/playbook: bootstrap shim shipped in the marketplace plugin. Claude Code
# puts a plugin's bin/ on the Bash tool's PATH, so `playbook` resolves even on
# a machine that installed only the plugin and never ran install.sh.
#
# It runs the real binary when one exists. When none does, it runs the shipped
# install.sh once (binary, PATH and init, no opt-in layers) pinned to this
# plugin's version, then runs the installed binary (it prints what it installs first, and
# PLAYBOOK_NO_AUTO_INSTALL=1 or ~/.config/playbook/no-auto-install turns it off). A guard variable stops it
# from ever calling itself.
set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SELF_DIR/.." && pwd)"
BIN_DIR="${PLAYBOOK_BIN_DIR:-$HOME/.local/bin}"

is_real() {
    local c="$1"
    if [ ! -x "$c" ] || [ ! -f "$c" ]; then return 1; fi
    if [ "$(cd "$(dirname "$c")" && pwd)" = "$SELF_DIR" ]; then return 1; fi
    return 0
}

find_real() {
    local c dir
    for c in "$BIN_DIR/playbook" "$HOME/.local/bin/playbook" \
        /opt/homebrew/bin/playbook /usr/local/bin/playbook \
        /home/linuxbrew/.linuxbrew/bin/playbook; do
        if is_real "$c"; then printf '%s' "$c"; return 0; fi
    done
    local IFS=:
    for dir in $PATH; do
        [ -n "$dir" ] || continue
        if is_real "$dir/playbook"; then printf '%s' "$dir/playbook"; return 0; fi
    done
    return 1
}

if real="$(find_real)"; then
    exec "$real" "$@"
fi

INSTALL_HINT="curl -fsSL https://raw.githubusercontent.com/pragmatic-engineer/playbook/main/install.sh | bash"

# The SessionStart hook runs `playbook hook migration-check` through this shim.
# With no binary it must neither install anything nor fail the session: print
# the same warning the binary would and stop. (src/hooks/migration_check.rs
# holds the canonical text; a test keeps the two equal.)
if [ "${1:-}" = "hook" ] && [ "${2:-}" = "migration-check" ]; then
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"playbook is installed as a plugin only. Run /playbook:setup to install the binary and guards."}}'
    exit 0
fi

# The worktree hooks run with a timeout and Claude Code expects the new path on
# stdout. With no binary they must fail loudly and fast, never install inside
# the hook and never pretend to succeed.
if [ "${1:-}" = "hook" ] && { [ "${2:-}" = "worktree-create" ] || [ "${2:-}" = "worktree-remove" ]; }; then
    echo "playbook: the binary is not installed, so the worktree hook cannot run. Run: $INSTALL_HINT" >&2
    exit 127
fi

# Opt out of the automatic install with PLAYBOOK_NO_AUTO_INSTALL=1, or by
# creating ~/.config/playbook/no-auto-install. The shim then only prints the hint.
if [ "${PLAYBOOK_NO_AUTO_INSTALL:-}" = "1" ] || [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/playbook/no-auto-install" ]; then
    echo "playbook: the binary is not installed and automatic install is off. Run: $INSTALL_HINT" >&2
    exit 127
fi

if [ "${PLAYBOOK_SHIM_BOOTSTRAP:-}" = "1" ] || [ ! -f "$ROOT/install.sh" ]; then
    echo "playbook: the binary is not installed. Run: $INSTALL_HINT" >&2
    exit 127
fi

version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/.claude-plugin/plugin.json" 2>/dev/null | head -n 1)"
echo "playbook: binary not found. Installing ${version:+v$version }once into $BIN_DIR with the plugin's installer: it downloads the release from GitHub, checks its SHA256, adds $BIN_DIR to your shell PATH and wires hooks in ~/.claude/settings.json. Opt out with PLAYBOOK_NO_AUTO_INSTALL=1." >&2
if ! PLAYBOOK_SHIM_BOOTSTRAP=1 PLAYBOOK_REF="${version:+v$version}" \
    bash "$ROOT/install.sh" --yes --binary-only >&2; then
    echo "playbook: install failed. Run the installer by hand: $INSTALL_HINT" >&2
    exit 127
fi

if real="$(find_real)"; then
    exec "$real" "$@"
fi
echo "playbook: installed, but the binary is still not found in $BIN_DIR" >&2
exit 127
