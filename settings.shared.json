{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "DISABLE_UPGRADE_COMMAND": "1",
    "DISABLE_COST_WARNINGS": "0",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_TOOL_SEARCH": "1",
    "DO_NOT_TRACK": "1"
  },
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Task(subagent_type:*)",
      "Task(Explore)",
      "TaskOutput",
      "Glob",
      "Grep",
      "ExitPlanMode",
      "EnterPlanMode",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "KillShell",
      "Skill",
      "MCPSearch",
      "AskUserQuestion",
      "ListMcpResourceTool",
      "ReadMcpResourceTool",
      "Write(/tmp/**)",
      "Read(/tmp/**)",
      "Write(**/.claude/**)",
      "Read(**/.claude/**)",
      "Edit(**/.claude/**)",
      "Bash($HOME/.claude/**)",
      "Bash(jq:*)",
      "Bash(gh:*)",
      "Bash(file:*)",
      "Bash(git:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(sed:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(tar:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(grep:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/node_modules/**)"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git push --force:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(xargs:*)",
      "Bash(node:*)",
      "Bash(sqlite3:*)",
      "Bash(python3:*)",
      "Bash(make:*)",
      "Bash(awk:*)",
      "Bash(go:*)",
      "Bash(psql:*)",
      "Bash(source:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "playbook hook rm-workspace-guard",
            "if": "Bash(rm:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "playbook hook bg-await-guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "playbook hook no-slop-guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "playbook hook precommit-check",
            "if": "Bash(git commit:*)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "playbook hook no-slop-guard",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.config/playbook/statusline.sh",
    "refreshInterval": 30
  },
  "outputStyle": "Concise & Direct",
  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": false,
  "editorMode": "normal",
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": false,
  "useAutoModeDuringPlan": true
}
