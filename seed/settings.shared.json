{
  "permissions": {
    "allow": [
      "Agent",
      "Glob",
      "Grep",
      "ExitPlanMode",
      "EnterPlanMode",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskStop",
      "Skill",
      "ToolSearch",
      "AskUserQuestion",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "Write(/tmp/**)",
      "Read(/tmp/**)",
      "Write(**/.claude/**)",
      "Read(**/.claude/**)",
      "Edit(**/.claude/**)",
      "Bash($HOME/.claude/**)",
      "Bash(gh:*)",
      "Bash(file:*)",
      "Bash(git:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(sed:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(tar:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(grep:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(mkdir:*)",
      "Bash(playbook mode status:*)",
      "Bash(playbook mode ask)",
      "Bash(playbook run-context:*)",
      "Bash(playbook commands:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/node_modules/**)"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git push --force:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(xargs:*)",
      "Bash(node:*)",
      "Bash(sqlite3:*)",
      "Bash(python3:*)",
      "Bash(make:*)",
      "Bash(awk:*)",
      "Bash(go:*)",
      "Bash(psql:*)",
      "Bash(source:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "playbook hook rm-workspace-guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "playbook hook bg-await-guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "playbook hook no-slop-guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "playbook hook precommit-check",
            "if": "Bash(git commit:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "playbook hook commit-message-sanitizer",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "playbook hook policy-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "playbook hook no-slop-guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "playbook hook policy-guard",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "playbook statusline",
    "refreshInterval": 30
  }
}
