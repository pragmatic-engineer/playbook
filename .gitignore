# Allowlist strategy: ignore everything, then re-include custom content only.
# This keeps credentials, session history, caches, and server-pushed state
# out of git by default. Anything not explicitly un-ignored below stays out.

/*

# --- Custom content to track ---
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/NOTICE-pbdoc
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/SECURITY.md
!/install.sh
!/install-pbtop.sh
!/justfile
!/flake.nix
!/flake.lock
!/seed/
!/plugins/
!/scripts/
!/packaging/
!/CHANGELOG.md
!/docs/
!/.github/
# Rust binary scaffold (ADR 0007): Cargo.lock is committed per the repo's
# pinned-dependency convention. target/ stays ignored via the default /* rule.
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/osv-scanner.toml
!/.cargo/
!/crates/

# --- Re-ignore generated/vendored content inside tracked dirs ---
.DS_Store
*.bak
*~
